rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Docentes autorizados: un documento por UID de Authentication (se crea a mano en la consola).
    // Se autoriza por UID y no por correo: cualquiera puede registrar una cuenta con la clave de API pública,
    // pero nadie puede darse de alta a sí mismo en esta colección.
    function esDocente() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/docentes/$(request.auth.uid));
    }

    match /docentes/{uid} {
      // Cada persona solo puede comprobar su propio documento (para que el panel sepa si tiene permiso).
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /encuestas_habitos/{id} {
      // Solo docentes autorizados leen y borran (el panel). Nadie edita desde el navegador.
      allow read: if esDocente();
      allow delete: if esDocente();
      allow update: if false;

      // diasDesayuno y celularAntesDormir son opcionales en las reglas para que una pestaña con la versión
      // anterior del formulario no pierda respuestas mientras se actualiza; el formulario nuevo los exige.
      allow create: if
        request.resource.data.keys().hasOnly(
          ['rol','rangoEdad','horasSueno','vasosAgua','alimentacion','horasPantalla','diasActividad',
           'diasDesayuno','celularAntesDormir','timestamp']) &&
        request.resource.data.keys().hasAll(
          ['rol','rangoEdad','horasSueno','vasosAgua','alimentacion','horasPantalla','diasActividad','timestamp']) &&
        request.resource.data.rol in ['Alumno','Profesor','Preceptor','Directivo'] &&
        request.resource.data.rangoEdad in ['Menos de 12','12 a 14','15 a 17','18 a 25','26 a 40','41 a 60','Más de 60'] &&
        request.resource.data.horasSueno is number &&
        request.resource.data.horasSueno >= 0 && request.resource.data.horasSueno <= 12 &&
        request.resource.data.vasosAgua is int &&
        request.resource.data.vasosAgua >= 0 && request.resource.data.vasosAgua <= 30 &&
        request.resource.data.alimentacion in ['Omnívora','Vegetariana','Vegana','Otra'] &&
        request.resource.data.horasPantalla is number &&
        request.resource.data.horasPantalla >= 0 && request.resource.data.horasPantalla <= 24 &&
        request.resource.data.diasActividad in ['0','1-2','3','4+'] &&
        (!('diasDesayuno' in request.resource.data) ||
          (request.resource.data.diasDesayuno is int &&
           request.resource.data.diasDesayuno >= 0 && request.resource.data.diasDesayuno <= 7)) &&
        (!('celularAntesDormir' in request.resource.data) ||
          request.resource.data.celularAntesDormir in ['Nunca','Menos de 30 min','30 a 60 min','Más de 60 min']) &&
        request.resource.data.timestamp == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
