 @import "tailwindcss";
+
+/* ───────── Tokens de diseño ─────────
+   Un solo lugar para colores, bordes, sombras y tipografía. Los componentes usan solo estos nombres
+   (bg-surface, text-fg, ring-line, text-brand…), así el modo oscuro es automático (prefers-color-scheme). */
+:root {
+  color-scheme: light dark;
+
+  --page-1: #eef2ff; --page-2: #ffffff; --page-3: #ecfdf5;
+  --surface: #ffffff;       --surface-2: #f8fafc;     --line: #e2e8f0;
+  --fg: #0f172a;            --fg-soft: #334155;       --muted: #64748b;
+  --brand: #4f46e5;         --brand-text: #4338ca;    --brand-2: #7c3aed;
+  --brand-soft: #eef2ff;    --brand-line: #c7d2fe;
+  --danger: #b91c1c;        --danger-soft: #fef2f2;   --danger-line: #fecaca;
+  --ok: #15803d;            --ok-soft: #f0fdf4;       --ok-line: #bbf7d0;
+  --warn: #b45309;          --warn-soft: #fffbeb;     --warn-line: #fde68a;
+  --info: #0369a1;          --info-soft: #f0f9ff;     --info-line: #bae6fd;
+  --sombra: rgb(99 102 241 / 0.14);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    --page-1: #0b1020; --page-2: #0f172a; --page-3: #06201a;
+    --surface: #111a2e;     --surface-2: #1a2540;   --line: #2b3a5c;
+    --fg: #f1f5f9;          --fg-soft: #cbd5e1;     --muted: #a3b1c6;
+    --brand: #818cf8;       --brand-text: #c7d2fe;  --brand-2: #c4b5fd;
+    --brand-soft: #1e2350;  --brand-line: #3b4380;
+    --danger: #fca5a5;      --danger-soft: #3a1418; --danger-line: #7f1d1d;
+    --ok: #86efac;          --ok-soft: #0f2b1b;     --ok-line: #14532d;
+    --warn: #fcd34d;        --warn-soft: #33260a;   --warn-line: #78350f;
+    --info: #7dd3fc;        --info-soft: #0b2535;   --info-line: #0c4a6e;
+    --sombra: rgb(0 0 0 / 0.45);
+  }
+}
+
+@theme inline {
+  --font-sans: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+  --color-surface: var(--surface);   --color-surface-2: var(--surface-2);  --color-line: var(--line);
+  --color-fg: var(--fg);             --color-fg-soft: var(--fg-soft);      --color-muted: var(--muted);
+  --color-brand: var(--brand);       --color-brand-text: var(--brand-text); --color-brand-2: var(--brand-2);
+  --color-brand-soft: var(--brand-soft); --color-brand-line: var(--brand-line);
+  --color-danger: var(--danger);     --color-danger-soft: var(--danger-soft); --color-danger-line: var(--danger-line);
+  --color-ok: var(--ok);             --color-ok-soft: var(--ok-soft);      --color-ok-line: var(--ok-line);
+  --color-warn: var(--warn);         --color-warn-soft: var(--warn-soft);  --color-warn-line: var(--warn-line);
+  --color-info: var(--info);         --color-info-soft: var(--info-soft);  --color-info-line: var(--info-line);
+  --shadow-card: 0 10px 30px -12px var(--sombra);
+  --radius-card: 1.5rem;             /* tarjetas */
+  --radius-control: 1rem;            /* botones, campos, chips */
+}
+
+.fondo-app { background-image: linear-gradient(135deg, var(--page-1), var(--page-2) 50%, var(--page-3)); }
+
+/* Foco visible y consistente para teclado */
+:where(a, button, input, select, textarea, summary):focus-visible {
+  outline: 3px solid var(--brand);
+  outline-offset: 2px;
+}
+
+/* Respeta a quienes piden menos movimiento */
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; scroll-behavior: auto !important; }
+}
+
+/* Salto al contenido (solo visible con teclado) */
+.saltar { position: absolute; left: -9999px; top: 0; z-index: 50; }
+.saltar:focus { left: 1rem; top: 1rem; }
